APP_ENV=development
APP_RELEASE=local

DATABASE_URL=postgresql+psycopg://gowild:gowild@localhost:5432/gowild
REDIS_URL=redis://localhost:6379/0

API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

LOG_LEVEL=INFO
LOG_FORMAT=console
SENTRY_DSN=
MONITORING_ENABLED=false
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=

CORS_ORIGINS=http://localhost:3000
CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
HSTS_ENABLED=false
REQUEST_BODY_MAX_BYTES=65536
REQUEST_ID_MAX_LENGTH=128
AIRPORT_QUERY_MAX_LENGTH=100

CACHE_ENABLED=true
CACHE_SCHEMA_VERSION=v1
ROUTING_ALGORITHM_VERSION=v1
AIRPORT_SEARCH_CACHE_TTL_SECONDS=21600
SCHEDULE_STATUS_CACHE_TTL_SECONDS=300
SEARCH_CACHE_TTL_SECONDS=1800
SAME_DAY_SEARCH_CACHE_TTL_SECONDS=300
NO_RESULT_CACHE_TTL_SECONDS=300
CACHE_ERROR_BACKOFF_SECONDS=30
CACHE_OPERATION_TIMEOUT_MS=100
CACHE_LOCK_TTL_SECONDS=10

RATE_LIMIT_ENABLED=true
AIRPORT_RATE_LIMIT_PER_MINUTE=120
SEARCH_RATE_LIMIT_PER_MINUTE=30
SCHEDULE_STATUS_RATE_LIMIT_PER_MINUTE=60
TRUSTED_PROXY_NETWORKS=

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_RELEASE=local
