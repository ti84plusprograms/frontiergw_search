  "info": {
    "title": "Frontier GoWild Destination Explorer API",
    "version": "0.4.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/airports": {
      "get": {
        "operationId": "get_airports_api_v1_airports_get",
        "parameters": [
          {
            "description": "Non-whitespace airport code, city, or name.",
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "description": "Non-whitespace airport code, city, or name.",
              "minLength": 1,
              "pattern": ".*\\S.*",
              "title": "Query",
              "type": "string"
            }
          },
          {
            "description": "Maximum results (bounded).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "description": "Maximum results (bounded).",
              "maximum": 25,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AirportSearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Validation error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Internal error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "No active schedule"
          }
        },
        "summary": "Get Airports",
        "tags": [
          "airports"
        ]
      }
    },
